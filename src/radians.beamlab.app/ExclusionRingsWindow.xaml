<Window x:Class="radians.beamlab.app.ExclusionRingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced GSO exclusion — α rings"
        Height="360" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="#ffffff" Foreground="#1a1a1a"
        FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#444444"
                   Text="Concentric α rings from 0 outward. A beam whose footprint |α| (to the nearest visible GSO arc) falls below a ring's outer edge takes that ring's action: switched off, or attenuated by the given dB. Rows are sorted by outer α when applied."/>

        <DataGrid Grid.Row="1" x:Name="RingsGrid"
                  ItemsSource="{Binding ExclusionRings}"
                  SelectedItem="{Binding SelectedExclusionRing, Mode=TwoWay}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="#ffffff" RowBackground="#ffffff" AlternatingRowBackground="#f5f5f5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Outer α (deg)" Width="*"
                                    Binding="{Binding OuterDeg, StringFormat=F1, UpdateSourceTrigger=LostFocus}"/>
                <DataGridCheckBoxColumn Header="Off" Width="60"
                                        Binding="{Binding IsOff, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Atten (dB)" Width="*"
                                    Binding="{Binding AttenDb, StringFormat=F1, UpdateSourceTrigger=LostFocus}">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <!-- Attenuation is meaningless when the ring switches beams off. -->
                            <Setter Property="IsEnabled" Value="{Binding IsAttenuate}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOff}" Value="True">
                                    <Setter Property="Foreground" Value="#bbbbbb"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add ring" Command="{Binding AddExclusionRingCommand}" Padding="8,3" Margin="0,0,6,0"/>
            <Button Content="Remove selected" Command="{Binding RemoveExclusionRingCommand}" Padding="8,3"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Close" Click="OnClose" Padding="14,3" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
