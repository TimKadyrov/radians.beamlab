<UserControl x:Class="radians.beamlab.app.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#E9F4F8">
        <StackPanel MaxWidth="900" Margin="24,20">
            <TextBlock Text="radians beamlab" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Non-GSO system description, S.1503-4 mask production and orbit prototyping."
                       Foreground="#698089" Margin="0,2,0,14"/>

            <ItemsControl ItemsSource="{Binding Functions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="420" Margin="0,0,12,12" Padding="14,10"
                                Background="#ffffff" BorderBrush="#D1EBF5" BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                           Foreground="#698089" Margin="0,4,0,8" MinHeight="60"/>
                                <Button Content="Open" Width="80" HorizontalAlignment="Left"
                                        Tag="{Binding TabIndex}" Click="OnOpenClick"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Tools}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="420" Margin="0,0,12,12" Padding="14,10"
                                Background="#ffffff" BorderBrush="#D1EBF5" BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                           Foreground="#698089" Margin="0,4,0,8" MinHeight="60"/>
                                <Button Content="Open" Width="80" HorizontalAlignment="Left"
                                        Tag="{Binding Key}" Click="OnToolOpenClick"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Documentation" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="GuideButton" Content="User guide" Margin="0,0,8,0" Padding="10,3"
                        Click="OnGuideClick"/>
                <Button x:Name="CardsButton" Content="Parameter cards" Margin="0,0,8,0" Padding="10,3"
                        Click="OnCardsClick"/>
                <Button x:Name="OrbitCasesButton" Content="Orbit case guide" Margin="0,0,8,0" Padding="10,3"
                        Click="OnOrbitCasesClick"/>
                <Button x:Name="SolverGuideButton" Content="Repeat solver guide" Padding="10,3"
                        Click="OnSolverGuideClick"/>
            </StackPanel>

            <TextBlock Text="{Binding VersionText}" Foreground="#698089" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
