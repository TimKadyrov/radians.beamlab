<Window x:Class="radians.beamlab.app.SimulationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simulation runner"
        Height="660" Width="1180"
        Background="#E9F4F8" Foreground="#000000"
        FontFamily="Gibson, Segoe UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#000000"/><Setter Property="Margin" Value="0,2,0,2"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#ffffff"/><Setter Property="Foreground" Value="#000000"/><Setter Property="BorderBrush" Value="#8BC4CD"/><Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="0,1,0,1"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#ffffff"/><Setter Property="Foreground" Value="#0076A1"/><Setter Property="BorderBrush" Value="#0076A1"/><Setter Property="Padding" Value="6,3"/><Setter Property="Margin" Value="0,2,4,2"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#0B516F"/><Setter Property="BorderBrush" Value="#D1EBF5"/><Setter Property="Margin" Value="0,4,0,4"/><Setter Property="Padding" Value="6"/></Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
        <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#698089"
                       Text="Runs the epfd(down)/(is)/(up) simulation from a design document over the scheduler-driven operation model. Play animates the operation on the map (satellites, candidate and active links) without collecting statistics; Quick run executes the full accelerated simulation with no UI updates and writes the three CDF CSVs."/>

            <GroupBox Header="Inputs">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Design document"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding DesignPath, UpdateSourceTrigger=LostFocus}"/>
                    <Button    Grid.Row="0" Grid.Column="2" Content="…" Margin="4,1,0,1" Click="OnBrowseClick"/>
                    <TextBlock Grid.Row="1" Text="Operation profile (optional)"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding ProfilePath, UpdateSourceTrigger=LostFocus}"
                               ToolTip="An *.opprofile.json. When set it supplies the whole system side (scene, gates, geography, policy, duty) and overrides frequency, minimum elevation and the operating-params file; the remaining fields describe only the victim and the run."/>
                    <Button    Grid.Row="1" Grid.Column="2" Content="…" Margin="4,1,0,1" Click="OnBrowseProfileClick"/>
                    <TextBlock Grid.Row="2" Text="Operating params (optional)"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding OpParamsPath, UpdateSourceTrigger=LostFocus}"
                               ToolTip="An *.opparams.json from the R-set designer; ignored when an operation profile is set. Empty = permissive defaults at the minimum elevation below, no exclusion zone."/>
                    <Button    Grid.Row="2" Grid.Column="2" Content="…" Margin="4,1,0,1" Click="OnBrowseOpClick"/>
                    <TextBlock Grid.Row="3" Text="Frequency (GHz)"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding FrequencyGhzText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="4" Text="Victim GSO longitude (degE)"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding GsoLonText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="5" Text="Victim ES latitude (deg)"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding EsLatText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="6" Text="Victim ES longitude (deg)"/>
                    <TextBox   Grid.Row="6" Grid.Column="1" Text="{Binding EsLonText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="7" Text="ES dish diameter (m)"/>
                    <TextBox   Grid.Row="7" Grid.Column="1" Text="{Binding EsDishMText, UpdateSourceTrigger=LostFocus}"
                               ToolTip="S.1428 pattern diameter used for the victim ES (down) and the transmitting ES (up)."/>
                    <TextBlock Grid.Row="8" Text="ES power ceiling (dBW)"/>
                    <TextBox   Grid.Row="8" Grid.Column="1" Text="{Binding EsPowerDbwText, UpdateSourceTrigger=LostFocus}"
                               ToolTip="Uplink transmit ceiling; range-based power control keeps each link below it (constant flux at the serving satellite)."/>
                    <TextBlock Grid.Row="9" Text="Minimum elevation (deg)"/>
                    <TextBox   Grid.Row="9" Grid.Column="1" Text="{Binding MinElevText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="10" Text="Duration (days)"/>
                    <TextBox   Grid.Row="10" Grid.Column="1" Text="{Binding DurationDaysText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="11" Text="Time step (s)"/>
                    <TextBox   Grid.Row="11" Grid.Column="1" Text="{Binding StepSecText, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
            </GroupBox>

            <StackPanel Orientation="Horizontal">
                <Button Content="Validate inputs" Click="OnValidateClick"/>
                <Button x:Name="QuickBtn" Content="Quick run…" IsEnabled="{Binding RunEnabled}" Click="OnRunClick"
                        ToolTip="The accelerated statistics run: no UI updates; picks a base name, runs down (+is byproduct) and up on a worker thread, and writes base.down.csv / base.is.csv / base.up.csv."/>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Foreground="#698089" TextWrapping="Wrap"/>
        </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PlayBtn" Content="Play" Click="OnPlayClick"
                        ToolTip="Animates the operation: one simulation step per tick, satellites and links drawn live. Statistics are not collected — use Quick run for the CDFs."/>
                <Button x:Name="StopBtn" Content="Stop" IsEnabled="False" Click="OnStopClick"/>
                <TextBlock x:Name="PlayStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="#0B516F"/>
            </StackPanel>
            <Border Grid.Row="1" Margin="0,4,0,0" BorderBrush="#D1EBF5" BorderThickness="1" Background="#ffffff">
                <Grid>
                    <Canvas x:Name="StaticCanvas" ClipToBounds="True"/>
                    <Canvas x:Name="LiveCanvas" ClipToBounds="True"/>
                    <TextBlock Margin="8,4" VerticalAlignment="Top" HorizontalAlignment="Left"
                               Foreground="#698089" FontSize="11" TextWrapping="Wrap"
                               Text="service cells · satellites — thin lines: candidate (feasible) links, thick lines: active (granted) links"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
