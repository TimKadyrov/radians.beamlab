<Window x:Class="radians.beamlab.app.SimulationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simulation runner"
        Height="660" Width="1180"
        Background="#E9F4F8" Foreground="#000000"
        FontFamily="Gibson, Segoe UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#000000"/><Setter Property="Margin" Value="0,2,0,2"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#ffffff"/><Setter Property="Foreground" Value="#000000"/><Setter Property="BorderBrush" Value="#8BC4CD"/><Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="0,1,0,1"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#ffffff"/><Setter Property="Foreground" Value="#0076A1"/><Setter Property="BorderBrush" Value="#0076A1"/><Setter Property="Padding" Value="6,3"/><Setter Property="Margin" Value="0,2,4,2"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#0B516F"/><Setter Property="BorderBrush" Value="#D1EBF5"/><Setter Property="Margin" Value="0,4,0,4"/><Setter Property="Padding" Value="6"/></Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
        <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#698089"
                       Text="Runs the epfd(down)/(is)/(up) simulation from an orbit design document (the space segment) and an operation profile (the operated system). ▶ plays the operation on the map (satellites, candidate and active links) and ⏩ accelerates the same continuous timeline without touching the map — switch between them mid-run; neither collects statistics. Write CDFs executes the full statistics run with no UI updates and writes the three CDF CSVs."/>

            <GroupBox Header="Inputs">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Orbit design document"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding DesignPath, UpdateSourceTrigger=LostFocus}"/>
                    <Button    Grid.Row="0" Grid.Column="2" Content="…" Margin="4,1,0,1" Command="{Binding BrowseDesignCommand}"/>
                    <TextBlock Grid.Row="1" Text="Operation profile"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding ProfilePath, UpdateSourceTrigger=LostFocus}"
                               ToolTip="An *.opprofile.json — required. It supplies the whole system side (payload, transmission basics, gates, geography, policy, duty and the downlink frequency); the remaining fields describe only the victim and the run."/>
                    <Button    Grid.Row="1" Grid.Column="2" Content="…" Margin="4,1,0,1" Command="{Binding BrowseProfileCommand}"/>
                    <TextBlock Grid.Row="2" Text="Operating params (optional)"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding OpParamsPath, UpdateSourceTrigger=LostFocus}"
                               ToolTip="An *.opparams.json from the R-set designer — an alternative gate source: when set, the scheduler obeys the declared pointing/scheduling constraints instead of the profile's enforced gates (both directions). The transmission side still comes from the profile."/>
                    <Button    Grid.Row="2" Grid.Column="2" Content="…" Margin="4,1,0,1" Command="{Binding BrowseOpParamsCommand}"/>
                    <TextBlock Grid.Row="3" Text="Victim GSO longitude (degE)"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding GsoLonText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="4" Text="Victim ES latitude (deg)"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding EsLatText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="5" Text="Victim ES longitude (deg)"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding EsLonText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="6" Text="ES dish diameter (m)"/>
                    <TextBox   Grid.Row="6" Grid.Column="1" Text="{Binding EsDishMText, UpdateSourceTrigger=LostFocus}"
                               ToolTip="S.1428 pattern diameter for the victim ES (down); also the transmitting ES (up) when the profile's uplink side declares no dish of its own."/>
                    <TextBlock Grid.Row="7" Text="Duration (days)"/>
                    <TextBox   Grid.Row="7" Grid.Column="1" Text="{Binding DurationDaysText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="8" Text="Time step (s)"/>
                    <TextBox   Grid.Row="8" Grid.Column="1" Text="{Binding StepSecText, UpdateSourceTrigger=LostFocus}"
                               ToolTip="The simulation's time step, 1 s preset. The status line warns when it samples the fastest crossing of the earth station's 3 dB beam fewer than three times. With the Random strategy and no hold the selection is redrawn at every step, so the step is also the reselection period."/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Limits (optional) — one point per line: epfd__db percent__time">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="epfd(down)"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" AcceptsReturn="True" Height="44" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                               Text="{Binding DownLimitsText, UpdateSourceTrigger=LostFocus}"
                               ToolTip="The applicable Article 22 epfd(down) rows (Tables 22-1A to 22-1E) for the band and dish. When entered, the run reports the epfd(down) verdict under the limit-curve rule."/>
                    <TextBlock Grid.Row="1" Text="epfd(is)"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" AcceptsReturn="True" Height="44" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                               Text="{Binding IsLimitsText, UpdateSourceTrigger=LostFocus}"
                               ToolTip="The applicable Article 22 epfd(is) rows (Table 22-3). When entered, the run reports the epfd(is) verdict; no is CDF is written for a declared-mask footprint."/>
                    <TextBlock Grid.Row="2" Text="epfd(up)"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" AcceptsReturn="True" Height="44" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                               Text="{Binding UpLimitsText, UpdateSourceTrigger=LostFocus}"
                               ToolTip="The applicable Article 22 epfd(up) rows (Table 22-2). When entered, the run reports the epfd(up) verdict under the limit-curve rule."/>
                </Grid>
            </GroupBox>

            <StackPanel Orientation="Horizontal">
                <Button Content="Validate inputs" Command="{Binding ValidateCommand}"/>
                <Button x:Name="QuickBtn" Content="Write CDFs…" IsEnabled="{Binding RunEnabled}" Command="{Binding WriteCdfsCommand}"
                        ToolTip="The statistics run: no UI updates; picks a base name, runs down (+is byproduct) and up on a worker thread, and writes base.down.csv / base.is.csv / base.up.csv."/>
                <Button Content="View CDFs…" Command="{Binding ViewCdfsCommand}"
                        ToolTip="Open existing CDF CSV files (this window's Write CDFs output, or any run's) in the CDF viewer — pick one or more."/>
                <Button x:Name="GuideBtn" Content="What feeds the run?" Command="{Binding OpenGuideCommand}"
                        ToolTip="Opens the accompanying page explaining which input supplies what: the orbit design document, the operation profile, the operating params and the loose fields."/>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Foreground="#698089" TextWrapping="Wrap"/>
        </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PlayBtn" Content="▶" FontSize="14" Width="34" Command="{Binding PlayCommand}"
                        ToolTip="Play: one simulation step per tick, satellites and links drawn live. Switches an accelerated run back to normal pace on the same timeline."/>
                <Button x:Name="FfBtn" Content="⏩" FontSize="14" Width="34" Command="{Binding FastForwardCommand}"
                        ToolTip="Accelerated play: the same continuous timeline, many steps per tick with no map updates — the last frame stays and only the status clock moves. Switch back to ▶ at any moment."/>
                <Button x:Name="StopBtn" Content="⏹" FontSize="14" Width="34" IsEnabled="False" Command="{Binding StopCommand}"/>
                <TextBlock x:Name="PlayStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="#0B516F"/>
            </StackPanel>
            <Border Grid.Row="1" Margin="0,4,0,0" BorderBrush="#D1EBF5" BorderThickness="1" Background="#ffffff">
                <Grid>
                    <Canvas x:Name="StaticCanvas" ClipToBounds="True"/>
                    <Canvas x:Name="LiveCanvas" ClipToBounds="True"/>
                    <TextBlock Margin="8,4" VerticalAlignment="Top" HorizontalAlignment="Left"
                               Foreground="#698089" FontSize="11" TextWrapping="Wrap"
                               Text="service cells · satellites — thin lines: candidate (feasible) links, thick lines: active (granted) links"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
